#include "/Engine/Private/Common.ush"
#include "GroundInteractionCommon.ush"

RWTexture2D<float> HeightTexture;
Texture2D<float> CurrentDepthTexture;

int2 NumCells;
int2 ScrollPixels;
float MaxSceneDepth;
float SceneDepthInvalidEpsilon;
float DepthOffsetZ;
float PulseStrength;

[numthreads(GI_THREADGROUP_SIZE_X, GI_THREADGROUP_SIZE_Y, GI_THREADGROUP_SIZE_Z)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (DispatchThreadId.x >= NumCells.x || DispatchThreadId.y >= NumCells.y)
	{
		return;
	}

	const int2 Pixel = int2(DispatchThreadId.xy);
	const int2 SourceDepthPixel = Pixel + ScrollPixels;

	float SceneDepth = GI_InvalidBaseDepth;

	if (SourceDepthPixel.x >= 0 && SourceDepthPixel.y >= 0 && SourceDepthPixel.x < NumCells.x && SourceDepthPixel.y < NumCells.y)
	{
		SceneDepth = CurrentDepthTexture.Load(int3(SourceDepthPixel, 0)).r;
	}

	if (!GI_IsValidSceneDepth(SceneDepth, MaxSceneDepth, SceneDepthInvalidEpsilon))
	{
		return;
	}

	const float RebasedSceneDepth = SceneDepth + DepthOffsetZ;

	if (!GI_IsValidSceneDepth(RebasedSceneDepth, MaxSceneDepth, SceneDepthInvalidEpsilon))
	{
		return;
	}

	HeightTexture[Pixel] = HeightTexture[Pixel] + max(PulseStrength, 0.0f);
}
