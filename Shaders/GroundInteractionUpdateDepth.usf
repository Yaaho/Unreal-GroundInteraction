#include "/Engine/Private/Common.ush"
#include "GroundInteractionCommon.ush"

RWTexture2D<float> DepthTexture;
RWTexture2D<float> FadeTexture;

Texture2D<float> CurrentDepthTexture;

int2 TextureSize;
float MaxSceneDepth;
float SceneDepthInvalidEpsilon;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (DispatchThreadId.x >= TextureSize.x || DispatchThreadId.y >= TextureSize.y)
	{
		return;
	}
	
	const int2 Pixel = int2(DispatchThreadId.xy);

	float Depth = DepthTexture[Pixel];
	float Fade = FadeTexture[Pixel];

	if (!GI_IsValidState(Depth, Fade))
	{
		Depth = GI_InvalidBaseDepth;
		Fade = GI_InvalidFadeHeight;
	}

	const float SceneDepth = CurrentDepthTexture.Load(int3(Pixel, 0)).r;
	
	// 현재 위치에 프록시가 있으면 새 contact로 취급.
	// R = base depth
	// G = fade height, contact 순간에는 0
	if (GI_IsValidSceneDepth(SceneDepth, MaxSceneDepth, SceneDepthInvalidEpsilon))
	{
		Depth = SceneDepth;
		Fade = 0.0f;
	}

	DepthTexture[Pixel] = Depth;
	FadeTexture[Pixel] = Fade;
}

