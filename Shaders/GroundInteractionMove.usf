#include "/Engine/Private/Common.ush"
#include "GroundInteractionCommon.ush"

Texture2D<float2> InputStateTexture;
RWTexture2D<float2> OutputStateTexture;

int2 TextureSize;
int2 ScrollPixels;
float PrevCaptureViewOriginZ;
float CurrentCaptureViewOriginZ;
float MaxSceneDepth;
float SceneDepthInvalidEpsilon;
uint bHasHistory;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (DispatchThreadId.x >= TextureSize.x || DispatchThreadId.y >= TextureSize.y)
	{
		return;
	}

	const int2 DstPixel = int2(DispatchThreadId.xy);
	float2 Result = GI_InvalidState();

	if (bHasHistory != 0)
	{
		const int2 SrcPixel = DstPixel + ScrollPixels;

		if (SrcPixel.x >= 0 && SrcPixel.y >= 0 &&
			SrcPixel.x < TextureSize.x && SrcPixel.y < TextureSize.y)
		{
			const float2 PrevState = InputStateTexture.Load(int3(SrcPixel, 0));

			if (GI_IsValid(PrevState))
			{
				const float RebaseDeltaZ =
					PrevCaptureViewOriginZ - CurrentCaptureViewOriginZ;

				Result = PrevState + RebaseDeltaZ.xx;
				
				// 이동한 좌표가 캡쳐 볼륨 밖이면 히스토리를 버린다.
				if (!GI_IsValid(Result) ||
					!GI_IsValidSceneDepth(Result.x, MaxSceneDepth, SceneDepthInvalidEpsilon))
				{
					Result = GI_InvalidState();
				}
			}
		}
	}

	OutputStateTexture[DstPixel] = Result;
}