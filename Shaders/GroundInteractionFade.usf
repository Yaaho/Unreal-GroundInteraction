#include "/Engine/Private/Common.ush"
#include "GroundInteractionCommon.ush"

RWTexture2D<float> DepthTexture;
RWTexture2D<float> FadeTexture;

int2 TextureSize;
float DeltaTimeSeconds;
float FadeRiseSpeed;
float FadeMaxHeight;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (DispatchThreadId.x >= TextureSize.x || DispatchThreadId.y >= TextureSize.y)
	{
		return;
	}

	const int2 Pixel = int2(DispatchThreadId.xy);

	const float Depth = DepthTexture[Pixel];
	float Fade = FadeTexture[Pixel];
	
	// Depth Value 와 Fade Value 가 Valid 하지 않다면 Invalidate
	if (!GI_IsValidState(Depth, Fade))
	{
		DepthTexture[Pixel] = GI_InvalidBaseDepth;
		FadeTexture[Pixel] = GI_InvalidFadeHeight;
		return;
	}
	
	if (FadeMaxHeight <= 0.0f)
	{
		DepthTexture[Pixel] = GI_InvalidBaseDepth;
		FadeTexture[Pixel] = GI_InvalidFadeHeight;
		return;
	}

	// Fade 진행
	Fade += max(FadeRiseSpeed, 0.0f) * max(DeltaTimeSeconds, 0.0f);

	// Fade 된 값이 FadeMaxHeight 보다 커졌으면 Invalidate
	if (Fade >= FadeMaxHeight)
	{
		DepthTexture[Pixel] = GI_InvalidBaseDepth;
		FadeTexture[Pixel] = GI_InvalidFadeHeight;
		return;
	}

	// 정상 fade 진행 중에는 depth는 건드리지 않는다.
	FadeTexture[Pixel] = Fade;
}