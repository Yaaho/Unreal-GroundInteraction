#include "/Engine/Private/Common.ush"

Texture2D<float> InputHeightTexture;
RWTexture2D<float> OutputHeightTexture;

int2 NumCells;
int2 ScrollPixels;

[numthreads(GI_THREADGROUP_SIZE_X, GI_THREADGROUP_SIZE_Y, GI_THREADGROUP_SIZE_Z)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (DispatchThreadId.x >= NumCells.x || DispatchThreadId.y >= NumCells.y)
	{
		return;
	}

	const int2 DstPixel = int2(DispatchThreadId.xy);
	const int2 SrcPixel = DstPixel + ScrollPixels;

	float OutHeight = 0.0f;

	if (SrcPixel.x >= 0 && SrcPixel.y >= 0 && SrcPixel.x < NumCells.x && SrcPixel.y < NumCells.y)
	{
		OutHeight = InputHeightTexture.Load(int3(SrcPixel, 0)).r;
	}

	OutputHeightTexture[DstPixel] = OutHeight;
}
